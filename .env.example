# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  TICKETING PLATFORM — Environment template                                  ║
# ║  Copy to .env and fill in real values. Never commit .env to version control.║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must be at least 256 bits (32+ characters). Use a random generator:
#   openssl rand -base64 32
JWT_SECRET=CHANGE_ME_use_openssl_rand_base64_32

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_USER=ticketing
DB_PASSWORD=CHANGE_ME_strong_password

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP=kafka:9092

# ── Recommendation agent (agent-service) ──────────────────────────────────────
# Both keys may be left empty. agent-service still starts, runs its migrations
# and serves the review UI without them — only the ingestion pipeline refuses
# to run, which is a clearer failure than a 401 from a vendor mid-batch.
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# Asymmetric embedding model (separate query/document encoding). Dimension must
# match vector(N) in agent-service V1__create_agent_tables.sql — currently 1024.
EMBEDDING_API_KEY=
EMBEDDING_MODEL=voyage-3
