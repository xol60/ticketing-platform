# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  TICKETING PLATFORM — Environment template                                  ║
# ║  Copy to .env and fill in real values. Never commit .env to version control.║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must be at least 256 bits (32+ characters). Use a random generator:
#   openssl rand -base64 32
JWT_SECRET=CHANGE_ME_use_openssl_rand_base64_32

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_USER=ticketing
DB_PASSWORD=CHANGE_ME_strong_password

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP=kafka:9092

# ── Recommendation agent (agent-service) ──────────────────────────────────────
# No API key anywhere: both models run locally, and no event data leaves the
# machine. The trade is that an 8B model fabricates readily, which is why every
# facet it produces must quote a span from the source description and is
# rejected when that span is not there — see V2__add_facet_grounding.sql.
#
# WHERE OLLAMA RUNS
#
# macOS — run it natively. Docker on macOS is a VM with a fixed memory ceiling
# that the rest of this stack largely fills, and a container cannot reach the
# Apple Silicon GPU at all. Native Ollama gets the host's full memory and Metal:
#
#     brew install ollama && ollama serve
#     ollama pull qwen3:8b && ollama pull bge-m3
#
# The default below points there. Nothing else to configure.
#
# Linux — Docker shares host memory directly, so the containerised path works:
#
#     docker compose --profile ollama-container up -d
#     OLLAMA_BASE_URL=http://ollama:11434
#
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_LLM_MODEL=qwen3:8b

# Embedding model. MUST be 1024-dimensional to match vector(1024) in the
# agent-service migrations — switching to a model of a different width
# (nomic-embed-text is 768) requires a migration and a full re-embed.
OLLAMA_EMBED_MODEL=bge-m3
