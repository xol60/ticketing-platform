# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  TICKETING PLATFORM — Environment template                                  ║
# ║  Copy to .env and fill in real values. Never commit .env to version control.║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must be at least 256 bits (32+ characters). Use a random generator:
#   openssl rand -base64 32
JWT_SECRET=CHANGE_ME_use_openssl_rand_base64_32

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_USER=ticketing
DB_PASSWORD=CHANGE_ME_strong_password

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP=kafka:9092

# ── Recommendation agent (agent-service) ──────────────────────────────────────
# No API key anywhere: both models run locally in the ollama container. The
# stack clones and comes up with nothing to configure, and no event data leaves
# the host. First boot downloads ~6.5 GB into the ollama-models volume.
#
# The trade is that an 8B model fabricates readily, which is why every facet it
# produces must cite a span from the source description and is rejected if that
# span is not there. See agent-service V2__add_facet_grounding.sql.
OLLAMA_LLM_MODEL=qwen3:8b

# Embedding model. MUST be 1024-dimensional to match vector(1024) in the
# agent-service migrations — switching to a model of a different width
# (nomic-embed-text is 768) requires a migration and a full re-embed.
OLLAMA_EMBED_MODEL=bge-m3
