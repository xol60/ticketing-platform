{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "infra-only (postgres + redis + kafka)",
      "runtimeExecutable": "docker-compose",
      "runtimeArgs": [
        "-f", "docker-compose.yml",
        "up",
        "postgres-master", "postgres-slave",
        "redis",
        "kafka", "kafka-init"
      ],
      "port": 5432,
      "description": "Start infrastructure only. Run this first, then launch individual services with 'mvn spring-boot:run'."
    },
    {
      "name": "all-services (docker-compose dev)",
      "runtimeExecutable": "docker-compose",
      "runtimeArgs": [
        "-f", "docker-compose.yml",
        "-f", "docker-compose.dev.yml",
        "up", "--build"
      ],
      "port": 3000
    },
    {
      "name": "all-services (docker-compose dev, no rebuild)",
      "runtimeExecutable": "docker-compose",
      "runtimeArgs": [
        "-f", "docker-compose.yml",
        "-f", "docker-compose.dev.yml",
        "up"
      ],
      "port": 3000
    },
    {
      "name": "api-gateway",
      "runtimeExecutable": "mvn",
      "runtimeArgs": ["spring-boot:run", "-pl", "api-gateway"],
      "port": 8090
    },
    {
      "name": "auth-service",
      "runtimeExecutable": "mvn",
      "runtimeArgs": ["spring-boot:run", "-pl", "auth-service"],
      "port": 8081
    },
    {
      "name": "ticket-service",
      "runtimeExecutable": "mvn",
      "runtimeArgs": ["spring-boot:run", "-pl", "ticket-service"],
      "port": 8082
    },
    {
      "name": "order-service",
      "runtimeExecutable": "mvn",
      "runtimeArgs": ["spring-boot:run", "-pl", "order-service"],
      "port": 8083
    },
    {
      "name": "saga-orchestrator",
      "runtimeExecutable": "mvn",
      "runtimeArgs": ["spring-boot:run", "-pl", "saga-orchestrator"],
      "port": 8084
    },
    {
      "name": "pricing-service",
      "runtimeExecutable": "mvn",
      "runtimeArgs": ["spring-boot:run", "-pl", "pricing-service"],
      "port": 8085
    },
    {
      "name": "reservation-service",
      "runtimeExecutable": "mvn",
      "runtimeArgs": ["spring-boot:run", "-pl", "reservation-service"],
      "port": 8086
    },
    {
      "name": "payment-service",
      "runtimeExecutable": "mvn",
      "runtimeArgs": ["spring-boot:run", "-pl", "payment-service"],
      "port": 8087
    },
    {
      "name": "secondary-market-service",
      "runtimeExecutable": "mvn",
      "runtimeArgs": ["spring-boot:run", "-pl", "secondary-market-service"],
      "port": 8088
    },
    {
      "name": "notification-service",
      "runtimeExecutable": "mvn",
      "runtimeArgs": ["spring-boot:run", "-pl", "notification-service"],
      "port": 8089
    },
    {
      "name": "ticketing-ui (standalone)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "ticketing-ui", "run", "dev"],
      "port": 3000
    }
  ]
}
