<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ticketing</groupId>
    <artifactId>ticketing-platform</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>
  <artifactId>search-service</artifactId>

  <!--
    Read-only derived-index service. Subscribes to event.search.indexed (Kafka)
    and projects the payload into an Elasticsearch index used by the public
    search endpoints. Postgres remains the source of truth; if ES is down or
    out-of-sync, ticket-service continues serving canonical event detail.
  -->

  <dependencies>
    <dependency>
      <groupId>com.ticketing</groupId>
      <artifactId>common-lib</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- Spring Data Elasticsearch — pulled in transitively via the starter so
         we get the matching Elasticsearch Java client + RestClient + ES domain
         annotations (@Document, @Field, @MultiField, etc.). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-elasticsearch</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>
    </dependency>
    <!-- Caffeine cache for the autocomplete /suggest endpoint. Using Caffeine
         (vs Redis) for two reasons: (1) matches the existing pattern in
         ticket-service (event-multiplier region) and pricing-service, so the
         monitoring + tuning playbook carries over; (2) suggest is read-only
         and trivially regenerable, so per-replica caches are fine — no need
         for cross-instance coherency.
         Caffeine's default eviction is W-TinyLFU (frequency-aware), so
         one-shot junk queries can't evict hot prefixes. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-cache</artifactId>
    </dependency>
    <dependency>
      <groupId>com.github.ben-manes.caffeine</groupId>
      <artifactId>caffeine</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
